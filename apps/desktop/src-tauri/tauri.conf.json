{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linetta",
  "version": "1.5.0",
  "identifier": "com.devlikebear.linetta",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Linetta",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "capabilities": [
        "default"
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwOUY1RkFFNkI1MDgzNTUKUldSVmcxQnJybCtmOE15MjJwaXBCbzJhM2M0VWJyell3aGs4b252cEZMUXVta1ArN3l1enJnazcK",
      "endpoints": [
        "https://github.com/devlikebear/linetta/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "resources": [
      "resources/*"
    ],
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
