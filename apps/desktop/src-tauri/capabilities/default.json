{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Linetta default capability — core + dialog + fs allowlist",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    "dialog:default",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-write-text-file"
  ]
}
